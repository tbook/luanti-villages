+-- Mods may add professions after mobs_mc has initialized. Keep the native
+-- jobsite search list in sync so both new and saved villagers can claim them.
+function mobs_mc.register_villager_profession(id, definition)
+	assert(type(id) == "string" and id ~= "", "villager profession id must be a nonempty string")
+	assert(not professions[id], "villager profession already registered: " .. id)
+	assert(type(definition) == "table" and type(definition.name) == "string"
+		and type(definition.texture) == "string" and type(definition.jobsite) == "string"
+		and type(definition.trades) == "table", "invalid villager profession definition")
+	professions[id] = table.copy(definition)
+	table.insert(profession_names, id)
+	jobsites = populate_jobsites()
+end
+
+local activity_modifiers = {}
+
+-- A modifier receives the current time in game ticks and may return an
+-- activity string. Returning nil leaves the default schedule in control.
+function mobs_mc.register_villager_activity_modifier(modifier)
+	assert(type(modifier) == "function", "villager activity modifier must be a function")
+	table.insert(activity_modifiers, modifier)
+end
